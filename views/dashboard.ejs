
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>StudyMate AI - 나의 학습 대시보드</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="layout">

  <aside class="sidebar">

    <div class="logo">✦ StudyMate AI</div>

    <p class="nav-label">MENU</p>

    <a href="/dashboard" class="nav-item active">📊 대시보드</a>
    <a href="#subjects" class="nav-item">📚 과목 관리</a>
    <a href="#records" class="nav-item">⏱ 공부 기록</a>
    <a href="#goals" class="nav-item">🎯 학습 목표</a>
    <a href="#exams" class="nav-item">📅 시험 일정</a>

    <div class="sidebar-bottom">

      <div class="user-mini">
        <%= currentUser ? currentUser.username : '학생' %>
      </div>

      <form action="/logout" method="POST">
        <button type="submit" class="logout-btn">
          로그아웃
        </button>
      </form>

    </div>

  </aside>

  <main class="main-content">

    <header class="topbar">

      <div>
        <h1>나의 학습 대시보드 👋</h1>
        <p>오늘도 목표를 향해 한 걸음 나아가 봐요!</p>
      </div>

      <div class="profile">
        👤
        <strong><%= currentUser.username %></strong>
      </div>

    </header>

    <!-- 통계 -->

    <section class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon purple">⏱</div>
        <p>누적 공부 시간</p>
        <h2>
          <%= Math.floor(stats.total_minutes / 60) %>시간
          <%= stats.total_minutes % 60 %>분
        </h2>
      </div>

      <div class="stat-card">
        <div class="stat-icon blue">📚</div>
        <p>등록된 과목</p>
        <h2><%= subjects.length %>개</h2>
      </div>

      <div class="stat-card">
        <div class="stat-icon green">📝</div>
        <p>공부 기록</p>
        <h2><%= stats.total_records %>회</h2>
      </div>

      <div class="stat-card">
        <div class="stat-icon orange">🎯</div>
        <p>학습 목표</p>
        <h2><%= goals.length %>개</h2>
      </div>

    </section>

    <!-- 과목 관리 -->

    <section id="subjects" class="dashboard-section">

      <%- include('partials/subjects') %>

    </section>

    <!-- 공부 기록 -->

    <section id="records" class="dashboard-section">

      <%- include('partials/records') %>

      <div class="section-heading">
        <div>
          <h2>📖 최근 공부 내역</h2>
          <p>내가 기록한 공부 내용을 확인하세요.</p>
        </div>
      </div>

      <div class="table-container">

        <table>

          <thead>
            <tr>
              <th>과목</th>
              <th>공부 시간</th>
              <th>날짜</th>
              <th>메모</th>
              <th>삭제</th>
            </tr>
          </thead>

          <tbody>

            <% if (records.length === 0) { %>

              <tr>
                <td colspan="5">
                  아직 공부 기록이 없습니다.
                </td>
              </tr>

            <% } %>

            <% records.forEach(record => { %>

              <tr>

                <td><%= record.subject_name %></td>

                <td><%= record.duration %>분</td>

                <td>
                  <%= String(record.study_date).slice(0, 10) %>
                </td>

                <td><%= record.memo || '-' %></td>

                <td>

                  <form
                    action="/records/<%= record.id %>/delete"
                    method="POST"
                    onsubmit="return confirm('이 기록을 삭제할까요?')"
                  >

                    <button type="submit" class="delete-btn">
                      삭제
                    </button>

                  </form>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </section>

    <!-- 학습 목표 -->

    <section id="goals" class="dashboard-section">
<form action="/goals" method="POST" class="subject-form">

  <input
    type="text"
    name="title"
    placeholder="학습 목표 이름"
    maxlength="255"
    required
  >

  <input
    type="number"
    name="target_minutes"
    placeholder="목표 공부 시간 (분)"
    min="1"
    max="1000000"
    required
  >

  <input
    type="date"
    name="deadline"
  >

  <button type="submit" class="primary-btn">
    + 학습 목표 등록
  </button>

</form>
      <div class="section-heading">
        <div>
          <h2>🎯 나의 학습 목표</h2>
          <p>목표를 세우고 꾸준히 달성해 보세요.</p>
        </div>
      </div>

      <div class="simple-grid">

        <% if (goals.length === 0) { %>

          <p class="empty-subject">
            등록된 학습 목표가 없습니다.
          </p>

        <% } %>

        <% goals.forEach(goal => { %>

          <div class="subject-card">

            <div class="subject-color" style="background:#10b981"></div>

            <div class="subject-info">

              <h3><%= goal.title %></h3>

              <p>
                목표 공부 시간:
                <%= goal.target_minutes %>분
              </p>

              <p>
                상태:
                <%= goal.is_completed ? '달성 완료 🎉' : '진행 중' %>
              </p>

<form
  action="/goals/<%= goal.id %>/toggle"
  method="POST"
>
  <button type="submit" class="primary-btn">
    <%= goal.is_completed ? '진행 중으로 변경' : '목표 달성 완료!' %>
  </button>
</form>

<form
  action="/goals/<%= goal.id %>/delete"
  method="POST"
  onsubmit="return confirm('이 목표를 삭제할까요?')"
>
  <button type="submit" class="delete-btn">
    목표 삭제
  </button>
</form>

            </div>

          </div>

        <% }) %>

      </div>

    </section>

<form action="/exams" method="POST" class="subject-form">

  <input
    type="text"
    name="subject_name"
    placeholder="시험 과목명 (예: 데이터베이스)"
    maxlength="100"
    required
  >

  <input
    type="date"
    name="exam_date"
    required
  >

  <input
    type="text"
    name="memo"
    placeholder="시험 범위 및 준비 내용"
    maxlength="1000"
  >

  <button type="submit" class="primary-btn">
    + 시험 일정 등록
  </button>

</form>

    <!-- 시험 일정 -->

    <section id="exams" class="dashboard-section">

      <div class="section-heading">
        <div>
          <h2>📅 다가오는 시험</h2>
          <p>시험 일정을 미리 확인하세요.</p>
        </div>
      </div>

      <div class="simple-grid">

        <% if (exams.length === 0) { %>

          <p class="empty-subject">
            등록된 시험 일정이 없습니다.
          </p>

        <% } %>

        <% exams.forEach(exam => { %>

          <div class="subject-card">

            <div class="subject-color" style="background:#f59e0b"></div>

            <div class="subject-info">

              <h3><%= exam.subject_name %></h3>

              <p>
                시험일:
                <%= String(exam.exam_date).slice(0, 10) %>
              </p>

              <p><%= exam.memo || '시험 준비를 시작해 보세요!' %></p>
<form
  action="/exams/<%= exam.id %>/delete"
  method="POST"
  onsubmit="return confirm('이 시험 일정을 삭제할까요?')"
>
  <button type="submit" class="delete-btn">
    시험 일정 삭제
  </button>
</form>
            </div>

          </div>

        <% }) %>

      </div>

    </section>

    <footer class="footer">
      <p>© 2026 StudyMate AI. 나만의 스마트 학습 공간.</p>
    </footer>

  </main>

</div>

</body>
</html>
